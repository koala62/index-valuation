.header { padding: 28rpx 24rpx 8rpx; }
.title { font-size: 40rpx; font-weight: 700; margin-bottom: 6rpx; }
.empty { text-align: center; color: #8a919e; padding: 120rpx 0; font-size: 26rpx; }
.name { font-size: 30rpx; font-weight: 600; }
.zone { font-size: 20rpx; color: #fff; padding: 4rpx 16rpx; border-radius: 20rpx; }
.composite { font-size: 56rpx; font-weight: 700; margin: 10rpx 0 4rpx; }
.c-label { font-size: 22rpx; font-weight: 400; color: #8a919e; margin-left: 8rpx; }
.gauge { height: 14rpx; border-radius: 8rpx; position: relative; margin: 12rpx 0 6rpx; opacity: .4;
  background: linear-gradient(90deg, #2e9e5b 0 20%, #7cb342 20% 50%, #f0a030 50% 80%, #d9453a 80% 100%); }
.pin { position: absolute; top: -6rpx; width: 8rpx; height: 26rpx; background: #1f2329; border-radius: 4rpx; }
.line { margin-top: 10rpx; }
.num { color: #1f2329; font-weight: 600; }
.warn { margin-top: 14rpx; font-size: 22rpx; color: #b26a00; background: #fdf3e0; border-radius: 12rpx; padding: 12rpx 16rpx; }
